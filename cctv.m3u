#EXTM3U
# CCTV cameras for Jellyfin Live TV (M3U Tuner).
# Streams are served by the local go2rtc hub (http://127.0.0.1:1984), which pulls
# each camera from the DVR once and fans it out — protecting the DVR's connection limit.
# Portable: if go2rtc + Jellyfin move together to another LAN box, 127.0.0.1 stays valid.

# ---------------- DVR 1 (live) ----------------
#EXTINF:-1 tvg-id="cam1" tvg-name="Cam 1" tvg-chno="1" group-title="CCTV",Cam 1
http://127.0.0.1:1984/api/stream.ts?src=cam1
#EXTINF:-1 tvg-id="cam2" tvg-name="Cam 2" tvg-chno="2" group-title="CCTV",Cam 2
http://127.0.0.1:1984/api/stream.ts?src=cam2
#EXTINF:-1 tvg-id="cam3" tvg-name="Cam 3" tvg-chno="3" group-title="CCTV",Cam 3
http://127.0.0.1:1984/api/stream.ts?src=cam3
#EXTINF:-1 tvg-id="cam4" tvg-name="Cam 4" tvg-chno="4" group-title="CCTV",Cam 4
http://127.0.0.1:1984/api/stream.ts?src=cam4

# ---------------- DVR 2 (live) ----------------
# cam5-8 are defined in go2rtc.yaml and live on the dashboard.
#EXTINF:-1 tvg-id="cam5" tvg-name="Cam 5" tvg-chno="5" group-title="CCTV",Cam 5
http://127.0.0.1:1984/api/stream.ts?src=cam5
#EXTINF:-1 tvg-id="cam6" tvg-name="Cam 6" tvg-chno="6" group-title="CCTV",Cam 6
http://127.0.0.1:1984/api/stream.ts?src=cam6
#EXTINF:-1 tvg-id="cam7" tvg-name="Cam 7" tvg-chno="7" group-title="CCTV",Cam 7
http://127.0.0.1:1984/api/stream.ts?src=cam7
#EXTINF:-1 tvg-id="cam8" tvg-name="Cam 8" tvg-chno="8" group-title="CCTV",Cam 8
http://127.0.0.1:1984/api/stream.ts?src=cam8
